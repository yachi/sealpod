{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "headless": true,
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-gpu",
        "--disable-dev-shm-usage",
        "--disable-software-rasterizer"
      ]
    },
    "isolated": true
  },
  "network": {
    "blockedOrigins": ["file://*"]
  },
  "outputDir": ".playwright-cli"
}
