# Sealpod — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Claude Code version (pin to specific version for reproducibility)
CLAUDE_CODE_VERSION=2.1.92

# Node.js base image version. Node 20 EOL: April 30, 2026.
# NODE_VERSION=22

# Session name visible in claude.ai/code
RC_NAME=sealpod

# Spawn mode: same-dir | worktree
RC_SPAWN=worktree

# Max concurrent sessions (default 32)
RC_CAPACITY=32

# Enable verbose logging: true | false
RC_VERBOSE=false

# Host path for container credentials (sealpod-auth writes here)
# Defaults to ~/.claude-docker to avoid conflicts with host Claude Code
CLAUDE_CONFIG_HOST_PATH=${HOME}/.claude-docker

# Host path to workspace directory to mount
WORKSPACE_HOST_PATH=${PWD}

# GitHub personal access token for gh CLI inside container (optional)
# GH_TOKEN=

# Host path for GitHub CLI config (optional — remove gh volume mount if unused)
# GH_CONFIG_HOST_PATH=${HOME}/.config/gh

# Enable browser automation via Playwright (default: true)
# When true: installs playwright-cli skill, deploys config, allows browser use
# When false: skill is not installed, browser capability hidden from Claude
SEALPOD_BROWSER_ENABLED=true

# Host path for Playwright browser cache (only needed when browser enabled)
# PLAYWRIGHT_HOST_PATH=${HOME}/.sealpod-playwright

# Resource limits (increase when SEALPOD_BROWSER_ENABLED=true)
# SEALPOD_MEM_LIMIT=4g
# SEALPOD_PIDS_LIMIT=1024

# --- Telegram Channel (optional — enables Telegram-based session control) ---
# Bot token from @BotFather. When set, starts Telegram channel alongside remote-control.
# TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (get from @userinfobot). Pre-seeds access.json
# so the bot only accepts messages from you, skipping the interactive pairing flow.
# TELEGRAM_USER_ID=

# Permission mode: bypassPermissions (default), default, acceptEdits, plan, auto, dontAsk
# bypassPermissions = container is the security boundary, no prompts
# default = all tool calls prompt (forwarded to Telegram via permission relay)
SEALPOD_PERMISSION_MODE=bypassPermissions

# Timezone
TZ=UTC
